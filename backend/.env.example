# Copy to .env and export, e.g.  set -a; source .env; set +a
OCEDA_DEMO_EMAIL=dr.sari@oceda.local
OCEDA_DEMO_PASSWORD=oceda123            # CHANGE
OCEDA_DEVICE_TOKEN=oceda-dev-device-token   # CHANGE (must match the Pi)
OCEDA_CORS_ORIGINS=http://localhost:5173

# AI (no file at OCEDA_MODEL => MOCK mode)
OCEDA_MODEL=models/model.onnx
OCEDA_MODEL_KIND=resnet                 # resnet | yolo
OCEDA_LABELS=Normal,Abnormal            # index order = model output order
# OCEDA_INPUT_SIZE=224                  # 640 for yolo
# OCEDA_NORM=imagenet                   # none => plain /255 (yolo, ultralytics cls)
# OCEDA_HEATMAP=auto                    # auto: use 2nd model output as CAM if present, else occlusion

# Email (empty host => .eml files in data/outbox/)
OCEDA_SMTP_HOST=
OCEDA_SMTP_PORT=587
OCEDA_SMTP_USER=
OCEDA_SMTP_PASSWORD=
OCEDA_SMTP_FROM=OCEDA <no-reply@your-domain>
